project(Nostalgia)

# Disable most messages from other CMakeLists.txt files
set(CMAKE_REQUIRED_QUIET ON)
set(CMAKE_RULE_MESSAGES OFF)
set(CMAKE_MESSAGE_LOG_LEVEL_SAVED ${CMAKE_MESSAGE_LOG_LEVEL})
set(CMAKE_MESSAGE_LOG_LEVEL NOTICE)

# Save the value of 'BUILD_SHARED_LIBS' and temporarily disable it
set(BUILD_SHARED_LIBS_SAVED ${BUILD_SHARED_LIBS})
set(BUILD_SHARED_LIBS OFF)

# Used by some edits to thirdparty CMakeLists.txt files
set(NOSTALGIA_THIRDPARTY_OBJECT_LIBRARIES ON)

# zlib
message("Configuring zlib")
set(ZLIB_BUILD_TESTING OFF)
set(ZLIB_BUILD_SHARED OFF)
set(ZLIB_BUILD_STATIC OFF)
set(ZLIB_INSTALL OFF)
add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/Nostalgia/thirdparty/zlib)

# bzip2
message("Configuring bzip2")
set(ENABLE_APP OFF)
set(ENABLE_APP_DEFAULT OFF)
set(ENABLE_LIB_ONLY CACHE BOOL ON)
set(ENABLE_STATIC_LIB CACHE BOOL OFF)
set(ENABLE_SHARED_LIB CACHE BOOL OFF)
add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/Nostalgia/thirdparty/bzip2)

# brotli
message("Configuring brotli")
set(BROTLI_BUILD_TOOLS OFF)
add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/Nostalgia/thirdparty/brotli)

# libpng
message("Configuring libpng")
set(SKIP_INSTALL_ALL ON)
set(PNG_SHARED OFF)
set(PNG_STATIC OFF)
add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/Nostalgia/thirdparty/libpng)

# freetype
message("Configuring freetype")
set(FT_REQUIRE_ZLIB OFF)
set(FT_REQUIRE_BZIP2 OFF)
set(FT_REQUIRE_PNG OFF)
set(FT_REQUIRE_HARFBUZZ OFF)
set(FT_REQUIRE_BROTLI OFF)
set(SKIP_INSTALL_ALL ON)
add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/Nostalgia/thirdparty/freetype)

# glfw
message("Configuring glfw")
set(GLFW_BUILD_EXAMPLES OFF)
set(GLFW_BUILD_TESTS OFF)
set(GLFW_BUILD_DOCS OFF)
set(GLFW_INSTALL OFF)
if(APPLE)
    set(GLFW_BUILD_COCOA)
endif()
add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/Nostalgia/thirdparty/glfw)

# Jolt
message("Configuring JoltPhysics")
set(ENABLE_INSTALL OFF)
if(WIN32 OR MSVC)
    set(JPH_USE_DX12 ON)
    set(JPH_USE_VK OFF)
else()
    set(JPH_USE_DX12 OFF)
    set(JPH_USE_VK ON)
endif()
set(JPH_USE_DXC ON)
set(JPH_USE_CPU_COMPUTE ON)
set(JPH_BUILD_SHARED_LIBS OFF)
add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/Nostalgia/thirdparty/JoltPhysics/Build)

# Re-enable messages
set(CMAKE_REQUIRED_QUIET OFF)
set(CMAKE_RULE_MESSAGES ON)
set(CMAKE_MESSAGE_LOG_LEVEL ${CMAKE_MESSAGE_LOG_LEVEL_SAVED})

# Set 'BUILD_SHARED_LIBS' back to its original value
set(BUILD_SHARED_LIBS ${BUILD_SHARED_LIBS_SAVED})

